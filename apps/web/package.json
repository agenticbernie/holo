{
  "name": "@holo/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "typecheck": "astro check",
    "preview": "astro preview",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "deploy": "astro build && wrangler deploy --config dist/server/wrangler.json",
    "deploy:dry": "astro build && wrangler deploy --dry-run --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.0",
    "@astrojs/react": "6.0.2",
    "@astryxdesign/core": "0.3.0",
    "@heroicons/react": "2.2.0",
    "@holo/api-client": "workspace:*",
    "astro": "7.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  }
}
