{
  "name": "holo",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "build": "turbo run build",
    "check": "biome check .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @holo/api test:integration",
    "test:e2e": "pnpm --filter @holo/web test:e2e",
    "openapi:validate": "pnpm --filter @holo/api openapi:validate",
    "dev": "pnpm --filter @holo/api dev",
    "dev:web": "pnpm --filter @holo/web dev",
    "deploy:web": "pnpm --filter @holo/web run deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "turbo": "2.10.8",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  }
}
